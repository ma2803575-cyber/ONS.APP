# Copy to backend/.env (or export in the shell). Never commit real values.
DATABASE_URL=sqlite:///./ons.db
# For PostgreSQL: postgresql+psycopg2://ons:ons@localhost:5432/ons
ONS_SECRET_KEY=change-me-to-a-long-random-string
ONS_TOKEN_DAYS=30
# Dev only: returns the password-reset token in the API response (no SMTP provider is wired in).
ONS_DEV_RESET=0
ONS_CORS=http://localhost:5173
